# --- Sandbox (default): nothing to set. Keys are generated at start-up. ---
CNPAY_MODE=sandbox

# Public base URL the providers can reach (notify_url / return_url). Must be HTTPS in live mode.
PUBLIC_URL=http://localhost:8091

# Admin / API basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Live mode: CNPAY_MODE=live plus the values below ---
# WeChat Pay API v3 (merchant platform → 账户中心 → API安全)
# WECHATPAY_MCH_ID=
# WECHATPAY_APP_ID=                          # official account / mini-program appid bound to the merchant
# WECHATPAY_MERCHANT_SERIAL_NUMBER=          # serial of apiclient_cert.pem
# WECHATPAY_PRIVATE_KEY=/run/secrets/apiclient_key.pem
# WECHATPAY_PUBLIC_KEY=/run/secrets/wechatpay_pub_key.pem
# WECHATPAY_PUBLIC_KEY_ID=PUB_KEY_ID_...
# WECHATPAY_API_V3_KEY=                      # 32 characters

# Alipay OpenAPI (open.alipay.com → 应用 → 开发设置, 公钥模式 RSA2)
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=/run/secrets/alipay_app_private_key.txt
# ALIPAY_PUBLIC_KEY=/run/secrets/alipay_public_key.txt   # 支付宝公钥, not your app public key
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do   # Alipay's own sandbox: https://openapi-sandbox.dl.alipaydev.com/gateway.do
